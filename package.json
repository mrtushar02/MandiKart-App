{
  "name": "mandikart-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MandiKart Multi-Surface Digital Agriculture Marketplace Monorepo",
  "workspaces": [
    "packages/*",
    "FarmerApp/mandikart-farmer-backend",
    "UserApp/backend",
    "Logistic/backend",
    "Logistic/frontend",
    "Admin/backend",
    "Admin/Frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:farmer": "npm --workspace=FarmerApp/mandikart-farmer-backend run dev",
    "dev:user": "npm --workspace=UserApp/backend run dev",
    "dev:logistic": "npm --workspace=Logistic/backend run dev",
    "dev:admin": "npm --workspace=@mandikart/admin-backend run dev",
    "dev:admin-frontend": "npm --workspace=@mandikart/admin-frontend run dev",
    "dev:logistic-frontend": "npm --workspace=@mandikart/logistic-frontend run dev",
    "dev:farmer-app": "npx expo start FarmerApp/mandikart-farmer-frontend --port 8082 --localhost",
    "dev:user-app": "npx expo start UserApp/Frontend --port 8083 --localhost",
    "dev:partner-app": "npx expo start Logistic/partner-app --port 8081 --localhost",
    "dev:simulator": "npm --prefix simulater run dev",
    "video:studio": "npm --prefix video run dev",
    "video:render-scene7": "npm --prefix video exec remotion render Scene7 out/scene7.mp4"
  },
  "keywords": [
    "agriculture",
    "marketplace",
    "farmer",
    "monorepo",
    "supabase"
  ],
  "author": "MandiKart Engineering Team",
  "license": "ISC",
  "dependencies": {
    "stripe": "^22.6.1"
  }
}
